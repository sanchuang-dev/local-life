{
  "name": "@sanchuang-dev/local-life-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "bootstrap-admin": "tsx src/scripts/bootstrap-admin.ts",
    "db:prepare": "tsx src/scripts/setup-db.ts",
    "db:grid-territory:preflight": "tsx src/scripts/check-grid-territory-conflicts.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@sanchuang-dev/local-life-contracts": "workspace:*",
    "better-sqlite3": "13.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
