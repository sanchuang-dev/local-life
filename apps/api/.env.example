NODE_ENV=development
HOST=127.0.0.1
PORT=4080
DATABASE_PATH=../../.data/local-life.sqlite
SESSION_TTL_HOURS=168

# Resident H5 / Admin origins allowed to submit cookie-authenticated requests.
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
WEB_BASE_URL=http://localhost:5173/local-life/

# Official WeChat public-account web OAuth (#113): configure it in the admin UI
# (系统管理 → 微信公众号) and activate the verified version. The resident OAuth
# provider is read from the database on every request, so activating a new
# AppID/AppSecret takes effect without a restart.
#
# The pre-#113 variables below are IGNORED. They are listed only so an operator
# can find and remove them; the API logs one warning with their names (never
# their values), and the callback URL is always derived as
# `${WEB_BASE_URL origin}/api/auth/wechat/callback`.
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URI=

# WeChat admin config master key (#113). Encrypts the AppSecret rows stored in
# SQLite with AES-256-GCM; the key itself never enters the database, responses,
# logs or the front-end bundle. Configure EXACTLY ONE of:
#   - WECHAT_CONFIG_MASTER_KEY_FILE: path to a mounted file whose content is the
#     base64 of 32 random bytes (recommended for deployments);
#   - WECHAT_CONFIG_MASTER_KEY: the same base64 value provided inline.
# When neither is set the API still starts, but the admin feature fails closed
# (its responses report masterKeyAvailable=false and nothing is decrypted).
# Supplying both, malformed base64, or the wrong length fails startup.
# Generate once and keep an offline backup; without it the encrypted rows are
# unrecoverable. Never commit a real key.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# WECHAT_CONFIG_MASTER_KEY_FILE=/run/secrets/wechat-config-master-key
# WECHAT_CONFIG_MASTER_KEY=
# Master-key generation label stored with each ciphertext; rotate it together
# with the key. Defaults to v1 when omitted.
# WECHAT_CONFIG_KEY_ID=v1

# Only for isolated local/test development. Never enable in production.
AUTH_DEV_ENABLED=false

# Optional only when H5 and API are intentionally served across subdomains.
# COOKIE_DOMAIN=.example.com

# CRMEB mall integration (Issue #63). Configure CRMEB_BASE_URL, CRMEB_OUTAPI_APPID
# and CRMEB_OUTAPI_APPSECRET together; supplying only some of them fails startup.
# When all three are absent the adapter reports `not_configured` and never fakes
# products or orders. The appid/appsecret are the CRMEB "对外接口账号" credentials,
# and that account must be granted the outapi product/order/refund interfaces.
# CRMEB_BASE_URL=https://mall.example.com
# CRMEB_OUTAPI_APPID=
# CRMEB_OUTAPI_APPSECRET=
# Optional resident-facing H5 origin; defaults to CRMEB_BASE_URL.
# CRMEB_H5_BASE_URL=https://mall.example.com
# CRMEB_TIMEOUT_MS=10000

# Optional: Tencent hosted location picker for admin community address selection.
# Browser-visible key; restrict to approved sites in Tencent LBS console.
# TENCENT_MAP_PICKER_KEY=
