NODE_ENV=development
HOST=127.0.0.1
PORT=4080
DATABASE_PATH=../../.data/local-life.sqlite
SESSION_TTL_HOURS=168

# Resident H5 / Admin origins allowed to submit cookie-authenticated requests.
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
WEB_BASE_URL=http://localhost:5173/local-life/

# Optional official WeChat public-account web OAuth. Configure all three together.
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URI=https://your-domain.example/api/auth/wechat/callback

# Only for isolated local/test development. Never enable in production.
AUTH_DEV_ENABLED=false

# Optional only when H5 and API are intentionally served across subdomains.
# COOKIE_DOMAIN=.example.com

# CRMEB mall integration (Issue #63). Configure CRMEB_BASE_URL, CRMEB_OUTAPI_APPID
# and CRMEB_OUTAPI_APPSECRET together; supplying only some of them fails startup.
# When all three are absent the adapter reports `not_configured` and never fakes
# products or orders. The appid/appsecret are the CRMEB "对外接口账号" credentials,
# and that account must be granted the outapi product/order/refund interfaces.
# CRMEB_BASE_URL=https://mall.example.com
# CRMEB_OUTAPI_APPID=
# CRMEB_OUTAPI_APPSECRET=
# Optional resident-facing H5 origin; defaults to CRMEB_BASE_URL.
# CRMEB_H5_BASE_URL=https://mall.example.com
# CRMEB_TIMEOUT_MS=10000
