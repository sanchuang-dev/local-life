{
  "name": "@sanchuang-dev/local-life",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @sanchuang-dev/local-life-contracts build && pnpm --parallel --filter @sanchuang-dev/local-life-web --filter @sanchuang-dev/local-life-admin --filter @sanchuang-dev/local-life-api dev",
    "dev:web": "pnpm --filter @sanchuang-dev/local-life-web dev",
    "dev:admin": "pnpm --filter @sanchuang-dev/local-life-contracts build && pnpm --filter @sanchuang-dev/local-life-admin dev",
    "dev:api": "pnpm --filter @sanchuang-dev/local-life-contracts build && pnpm --filter @sanchuang-dev/local-life-api dev",
    "build": "pnpm -r --if-present build",
    "lint": "oxlint apps packages --ignore-pattern '**/dist/**'",
    "typecheck": "pnpm --filter @sanchuang-dev/local-life-contracts build && pnpm -r --if-present typecheck",
    "test": "pnpm --filter @sanchuang-dev/local-life-contracts build && pnpm -r --workspace-concurrency=1 --if-present test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxlint": "1.88.0",
    "typescript": "6.0.3"
  }
}
